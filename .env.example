# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# URL pública definitiva del sitio (sin barra final). Necesaria para canónicas, sitemap y metadatos sociales.
SITE_URL=https://votoenclaro.example

# Interruptor de indexación. Mientras no sea "true", todas las páginas llevan noindex y robots.txt
# bloquea el rastreo. Actívalo solo cuando el titular haya revisado contenido y datos legales.
PUBLIC_INDEXABLE=false

# Google AdSense. Los anuncios permanecen desactivados mientras PUBLIC_ADS_ENABLED no sea "true"
# y no haya identificador de editor. Formato del identificador: ca-pub-0000000000000000
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
# Identificadores de bloque de anuncio creados en AdSense (opcional; sin ellos no se pinta ningún bloque).
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_FOOTER=

# Medición agregada sin cookies (opcional). Ej.: https://plausible.io/js/script.js con dominio,
# o la URL de tu instancia autoalojada de Umami. Vacío = sin medición.
PUBLIC_ANALYTICS_SCRIPT=
PUBLIC_ANALYTICS_DOMAIN=

# Mostrar entradas en estado borrador/revisado (solo en entornos de vista previa, nunca en producción).
PUBLIC_PREVIEW_DRAFTS=false
