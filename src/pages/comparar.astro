---
import Base from '../layouts/Base.astro';
import Quick from '../components/Quick.astro';
import AdSlot from '../components/AdSlot.astro';
import { publicados, alfa, ETIQUETAS, fechaCorta } from '../lib/content';
import { textoSobre } from '../lib/hemiciclo.js';

const partidos = (await publicados('partidos')).sort((a, b) => alfa(a.data.nombre, b.data.nombre));
const temas = (await publicados('temas')).sort((a, b) => a.data.orden - b.data.orden);
const propuestas = await publicados('propuestas');

const data = {
  partidos: partidos.map((p) => ({ id: p.data.id, nombre: p.data.nombre, siglas: p.data.siglas, programa: p.data.programa_2026.estado, color: p.data.color_grafico, ink: textoSobre(p.data.color_grafico) })),
  temas: temas.map((t) => ({ id: t.data.id, nombre: t.data.nombre })),
  propuestas: propuestas.map((p) => ({
    id: p.data.id,
    partido: p.data.partido,
    tema: p.data.tema,
    titulo: p.data.titulo,
    resumen: p.data.resumen,
    estado: ETIQUETAS.estadoPropuesta[p.data.estado],
    estadoClave: p.data.estado,
    tipo: ETIQUETAS.tipoInformacion[p.data.tipo_informacion],
    fuente: { emisor: p.data.fuentes[0].emisor, url: p.data.fuentes[0].url, fecha: fechaCorta(p.data.fuentes[0].fecha_documento) },
    desactualizado: p.data.revision.estado_editorial === 'desactualizado',
  })),
};
---
<Base title="Comparador de propuestas electorales 2026" description="Compara entre dos y cuatro partidos sobre los mismos temas: resumen fiel, estado de cada propuesta, fuente y fecha. Sin puntuaciones ni recomendaciones de voto." crumbs={[{ label: 'Comparar' }]}>
  <div class="wrap">
    <h1>Comparador de propuestas</h1>
    <div class="read">
      <Quick items={[
        'Elige entre 2 y 4 partidos y los temas que te interesen.',
        'Cada celda resume lo que plantea el partido, indica de qué tipo de fuente sale y enlaza a la explicación completa.',
        'No hay puntuaciones ni porcentajes de afinidad, y la web no guarda tu selección: solo queda en el enlace que tú decidas compartir.',
      ]} />
    </div>

    <form id="cmp-form" class="no-print" onsubmit="return false">
      <fieldset>
        <legend>Partidos <span class="muted small">(entre 2 y 4, en orden alfabético)</span></legend>
        <div class="chip-group" id="cmp-partidos">
          {data.partidos.map((p) => <label class="chip chip-p" style={`--pc:${p.color};--pc-ink:${p.ink}`}><input type="checkbox" name="partido" value={p.id} /><span><i class="pc-dot" aria-hidden="true"></i>{p.nombre}</span></label>)}
        </div>
        <p class="small muted" id="cmp-partidos-msg" aria-live="polite" style="margin:.5rem 0 0"></p>
      </fieldset>
      <fieldset>
        <legend>Temas</legend>
        <div class="chip-group" id="cmp-temas">
          {data.temas.map((t) => <label class="chip"><input type="checkbox" name="tema" value={t.id} checked /><span>{t.nombre}</span></label>)}
        </div>
        <p style="margin:.6rem 0 0;display:flex;gap:.5rem;flex-wrap:wrap">
          <button type="button" class="btn secondary small" data-temas="todos">Todos los temas</button>
          <button type="button" class="btn secondary small" data-temas="ninguno">Ninguno</button>
          <button type="button" class="btn secondary small" id="cmp-share">Copiar enlace a esta comparación</button>
          <span class="small muted" id="cmp-share-msg" aria-live="polite"></span>
        </p>
      </fieldset>
    </form>

    <div id="cmp-out" aria-live="polite">
      <p class="notice" id="cmp-loading">Cargando comparador…</p>
      <noscript><p class="notice warn">El comparador necesita JavaScript. Sin él, puedes consultar las mismas posiciones en las <a href="/temas/">páginas de cada tema</a>.</p></noscript>
    </div>

    <div class="read">
      <h2>Cómo leer la comparación</h2>
      <ul>
        <li><strong>Compromiso en el programa 2026:</strong> figura en el programa electoral de estas elecciones.</li>
        <li><strong>Posición declarada:</strong> sale de un documento oficial, una declaración o un voto reciente, pero aún no del programa 2026.</li>
        <li><strong>Medida ya aprobada:</strong> se aprobó en una etapa de gobierno anterior; se enlaza la norma.</li>
        <li><strong>No localizado / pendiente:</strong> no hemos encontrado información. No significa que el partido esté en contra.</li>
      </ul>
      <p class="small">El orden predeterminado es alfabético. <a href="/metodologia/">Metodología</a>.</p>
    </div>
  </div>
  <AdSlot slot="footer" />
  <script type="application/json" id="cmp-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type P = { id: string; nombre: string; siglas: string; programa: string; color: string; ink: string };
  type T = { id: string; nombre: string };
  type X = { id: string; partido: string; tema: string; titulo: string; resumen: string; estado: string; estadoClave: string; tipo: string; fuente: { emisor: string; url: string; fecha: string }; desactualizado: boolean };
  const data = JSON.parse(document.getElementById('cmp-data')!.textContent!) as { partidos: P[]; temas: T[]; propuestas: X[] };
  const MAX = 4, MIN = 2;
  const out = document.getElementById('cmp-out')!;
  const msg = document.getElementById('cmp-partidos-msg')!;
  const pBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="partido"]')];
  const tBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="tema"]')];

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  // Estado en el fragmento (#…): no se envía al servidor ni aparece en referencias a terceros.
  function leerHash() {
    const h = new URLSearchParams(location.hash.slice(1));
    const validP = new Set(data.partidos.map((p) => p.id));
    const validT = new Set(data.temas.map((t) => t.id));
    const ps = (h.get('partidos') || '').split(',').filter((x) => validP.has(x)).slice(0, MAX);
    const tsRaw = h.get('temas');
    const ts = tsRaw === null ? null : tsRaw.split(',').filter((x) => validT.has(x));
    pBoxes.forEach((b) => (b.checked = ps.includes(b.value)));
    if (ts) tBoxes.forEach((b) => (b.checked = ts.includes(b.value)));
  }
  function escribirHash() {
    const ps = pBoxes.filter((b) => b.checked).map((b) => b.value);
    const ts = tBoxes.filter((b) => b.checked).map((b) => b.value);
    const h = new URLSearchParams();
    if (ps.length) h.set('partidos', ps.join(','));
    if (ts.length !== tBoxes.length) h.set('temas', ts.join(','));
    const s = h.toString().replace(/%2C/g, ',');
    history.replaceState(null, '', s ? '#' + s : location.pathname);
  }

  function render() {
    const ps = data.partidos.filter((p) => pBoxes.some((b) => b.checked && b.value === p.id));
    const ts = data.temas.filter((t) => tBoxes.some((b) => b.checked && b.value === t.id));
    pBoxes.forEach((b) => (b.disabled = !b.checked && ps.length >= MAX));
    msg.textContent = ps.length >= MAX ? `Máximo ${MAX} partidos. Desmarca uno para elegir otro.` : `${ps.length} seleccionados.`;
    if (ps.length < MIN) {
      out.innerHTML = `<p class="notice info">Selecciona al menos ${MIN} partidos para comparar.</p>`;
      return;
    }
    if (!ts.length) {
      out.innerHTML = `<p class="notice info">Selecciona al menos un tema.</p>`;
      return;
    }
    const cols = ps.length;
    let html = `<div class="cmp-sticky" style="--cols:${cols}">${ps.map((p) => `<span class="pc-band" style="--pc:${p.color};--pc-ink:${p.ink}">${esc(p.siglas)}</span>`).join('')}</div><p class="small muted">${ts.length} ${ts.length === 1 ? 'tema' : 'temas'} · orden alfabético</p>`;
    for (const t of ts) {
      html += `<section class="cmp-tema"><h2 class="cmp-h">${esc(t.nombre)} <a class="small" href="/temas/${t.id}/">Ver tema</a></h2><div class="cmp-row" style="--cols:${cols}">`;
      for (const p of ps) {
        const items = data.propuestas.filter((x) => x.partido === p.id && x.tema === t.id);
        html += `<div class="cmp-cell" style="--pc:${p.color};--pc-ink:${p.ink}"><h3 class="cmp-p pc-band"><span>${esc(p.siglas)}</span> ${esc(p.nombre)}</h3><div class="cmp-body">`;
        if (!items.length) {
          html += `<p class="muted small">${p.programa === 'pendiente_publicacion' ? 'Programa 2026 pendiente de publicación; no localizado en otras fuentes consultadas.' : 'No localizado en las fuentes consultadas.'}</p>`;
        }
        for (const x of items) {
          const cls = x.estadoClave === 'compromiso_2026' ? 'ok' : x.estadoClave === 'posicion_vigente' ? 'info' : 'neutral';
          html += `<div class="cmp-item">
            <p class="cmp-t"><strong>${esc(x.titulo)}</strong></p>
            <p style="margin:.2rem 0"><span class="badge ${cls}">${esc(x.estado)}</span> <span class="badge neutral">${esc(x.tipo)}</span>${x.desactualizado ? ' <span class="badge warn">Desactualizado</span>' : ''}</p>
            <p class="small" style="margin:.3rem 0">${esc(x.resumen)}</p>
            <p class="src-inline" style="margin:0">Fuente: <a href="${esc(x.fuente.url)}" rel="noopener nofollow" target="_blank">${esc(x.fuente.emisor)}</a>${x.fuente.fecha ? ' · ' + esc(x.fuente.fecha) : ''} · <a href="/partidos/${p.id}/#${esc(x.id)}">Explicación ampliada</a></p>
          </div>`;
        }
        html += `</div></div>`;
      }
      html += `</div></section>`;
    }
    out.innerHTML = html;
  }

  pBoxes.concat(tBoxes).forEach((b) => b.addEventListener('change', () => { escribirHash(); render(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-temas]').forEach((btn) =>
    btn.addEventListener('click', () => { tBoxes.forEach((b) => (b.checked = btn.dataset.temas === 'todos')); escribirHash(); render(); }),
  );
  document.getElementById('cmp-share')!.addEventListener('click', async () => {
    const m = document.getElementById('cmp-share-msg')!;
    try { await navigator.clipboard.writeText(location.href); m.textContent = 'Enlace copiado.'; }
    catch { m.textContent = 'No se pudo copiar. Copia la dirección de la barra del navegador.'; }
  });
  window.addEventListener('hashchange', () => { leerHash(); render(); });
  try { leerHash(); render(); }
  catch (e) { out.innerHTML = '<p class="notice bad">No se pudo cargar el comparador. Recarga la página o consulta las <a href="/temas/">páginas de temas</a>.</p>'; console.error(e); }
</script>

<style is:global>
  .cmp-tema { border-top: 1px solid var(--line); padding: 0.25rem 0 1rem; }
  .cmp-h { font-size: 1.25rem; margin: 1rem 0 0.6rem; }
  .cmp-h a { font-family: var(--font-sans); font-weight: 500; }
  .cmp-row { display: grid; gap: 0.75rem; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .cmp-row { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .cmp-cell { border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, var(--pc) 5%, var(--paper)); overflow: hidden; }
  .cmp-p { font: 700 0.92rem/1.3 var(--font-sans); margin: 0; padding: 0.5rem 0.9rem; }
  .cmp-p span { font-weight: 900; }
  .cmp-body { padding: 0.75rem 0.9rem; }
  .cmp-sticky { position: sticky; top: 3.5rem; z-index: 10; display: grid; gap: 0.75rem; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); padding: 0.4rem 0; background: var(--paper); }
  .cmp-sticky span { text-align: center; font: 800 0.85rem/1 var(--font-sans); padding: 0.45rem; border-radius: 8px; }
  @media (max-width: 48rem) { .cmp-sticky { display: none; } }
  .chip-p input:checked + span { background: var(--pc); border-color: var(--pc); color: var(--pc-ink); }
  .chip-p input:checked + span .pc-dot { box-shadow: 0 0 0 2px var(--pc-ink); }
  .cmp-item + .cmp-item { border-top: 1px dashed var(--line); margin-top: 0.6rem; padding-top: 0.6rem; }
  .cmp-t { margin: 0; }
</style>
