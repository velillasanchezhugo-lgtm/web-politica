---
import Base from '../layouts/Base.astro';
---
<Base title="Buscar" description="Busca partidos, temas, propuestas, hitos históricos y términos del glosario." noindex nosearch crumbs={[{ label: 'Buscar' }]}>
  <div class="wrap read">
    <h1>Buscar</h1>
    <p class="small muted">El buscador funciona en tu navegador sobre un índice generado al publicar la web. No registramos lo que buscas.</p>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search" aria-live="polite"><p class="muted" id="search-loading">Cargando buscador…</p></div>
    <noscript><p class="notice warn">El buscador necesita JavaScript. Puedes navegar por <a href="/partidos/">partidos</a>, <a href="/temas/">temas</a>, <a href="/historia/">historia</a> o el <a href="/glosario/">glosario</a>.</p></noscript>
  </div>
</Base>
<script is:inline>
  (function () {
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = function () {
      document.getElementById('search-loading')?.remove();
      var ui = new PagefindUI({
        element: '#search', showSubResults: true, showImages: false, resetStyles: false,
        translations: { placeholder: 'Escribe lo que buscas', zero_results: 'No hay resultados para [SEARCH_TERM]', many_results: '[COUNT] resultados para [SEARCH_TERM]', one_result: '1 resultado para [SEARCH_TERM]', load_more: 'Ver más resultados', search_label: 'Buscar en la web', clear_search: 'Borrar' },
      });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    };
    s.onerror = function () {
      document.getElementById('search').innerHTML = '<p class="notice bad">El índice de búsqueda no está disponible en esta versión (se genera al compilar con <code>npm run build</code>).</p>';
    };
    document.head.appendChild(s);
  })();
</script>
<style is:global>
  #search { --pagefind-ui-primary: var(--ink); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--paper); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--paper-2); --pagefind-ui-font: var(--font-sans); }
</style>
