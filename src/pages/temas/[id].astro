---
import Base from '../../layouts/Base.astro';
import Quick from '../../components/Quick.astro';
import Claim from '../../components/Claim.astro';
import Revision from '../../components/Revision.astro';
import PropuestaCard from '../../components/PropuestaCard.astro';
import TemaVacio from '../../components/TemaVacio.astro';
import SourceList from '../../components/SourceList.astro';
import AdSlot from '../../components/AdSlot.astro';
import { publicados, alfa } from '../../lib/content';
import { textoSobre } from '../../lib/hemiciclo.js';

export async function getStaticPaths() {
  const temas = await publicados('temas');
  return temas.map((t) => ({ params: { id: t.data.id }, props: { t } }));
}
const { t } = Astro.props;
const d = t.data;
const partidos = (await publicados('partidos')).sort((a, b) => alfa(a.data.nombre, b.data.nombre));
const propuestas = (await publicados('propuestas')).filter((p) => p.data.tema === d.id);
const conPosicion = partidos.filter((p) => propuestas.some((x) => x.data.partido === p.data.id));
const todas = [...d.contexto, ...d.competencias].flatMap((a) => a.fuentes).concat(propuestas.flatMap((p) => p.data.fuentes));
---
<Base title={`${d.nombre}: qué proponen los partidos en las elecciones de 2026`} description={`${d.descripcion} Situación actual con datos oficiales, competencias y posiciones de cada partido con fuentes.`} crumbs={[{ href: '/temas/', label: 'Temas' }, { label: d.nombre_corto }]}>
  <article class="wrap">
    <h1>{d.nombre}</h1>
    <Revision revision={d.revision} />
    <div class="read">
      <Quick items={[
        d.descripcion,
        `${conPosicion.length} de ${partidos.length} formaciones tienen una posición publicada en este tema en nuestras fuentes.`,
        'Los partidos aparecen en orden alfabético. Ninguna posición se puntúa ni se valora como mejor o peor.',
      ]} />
      <p class="level-label">Explicación ampliada</p>
      <h2>Situación actual</h2>
      {d.contexto.length ? d.contexto.map((a) => <Claim a={a} />) : <p class="muted">Datos de contexto en preparación.</p>}
      <h2>¿Quién decide?</h2>
      {d.competencias.length ? d.competencias.map((a) => <Claim a={a} />) : <p class="muted">En preparación.</p>}
    </div>
    <AdSlot />
    <h2>Qué plantea cada partido</h2>
    <ul class="tema-mapa" role="list" aria-label="Formaciones con posición publicada en este tema">
      {partidos.map((p) => {
        const n = propuestas.filter((x) => x.data.partido === p.data.id).length;
        return <li style={`--pc:${p.data.color_grafico};--pc-ink:${textoSobre(p.data.color_grafico)}`}><a href={`#${p.data.id}`} class={n ? 'si' : 'no'}><b>{p.data.siglas}</b><span>{n ? `${n} ${n === 1 ? 'posición' : 'posiciones'}` : 'Sin información'}</span></a></li>;
      })}
    </ul>
    <p class="small"><a href={`/comparar/#temas=${d.id}`}>Comparar solo algunos partidos en este tema →</a></p>
    {partidos.map((p) => {
      const items = propuestas.filter((x) => x.data.partido === p.data.id);
      return (
        <section class="tema-block reveal" id={p.data.id} style={`--pc:${p.data.color_grafico};--pc-ink:${textoSobre(p.data.color_grafico)}`}>
          <h3><span class="pc-tag">{p.data.siglas}</span> <a href={`/partidos/${p.data.id}/`}>{p.data.nombre}</a></h3>
          {items.length ? <div class="grid wide">{items.map((x) => <PropuestaCard p={x.data} headingLevel={4} />)}</div> : <TemaVacio programa={p.data.programa_2026.estado} />}
        </section>
      );
    })}
    <div class="read">
      <p class="level-label">Fuentes y detalles</p>
      <SourceList fuentes={todas} titulo="Todas las fuentes de este tema" />
    </div>
  </article>
</Base>
<style>
  .tema-block { border-left: 5px solid var(--pc); padding: 0.25rem 0 0.75rem 1rem; margin: 1rem 0; scroll-margin-top: 5rem; }
  .tema-block :global(.propuesta) { border-top: 4px solid var(--pc); }
  .tema-mapa { list-style: none; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); margin: 0 0 1.5rem; }
  .tema-mapa a { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.6rem 0.75rem; border-radius: 10px; text-decoration: none; height: 100%; }
  .tema-mapa a.si { background: var(--pc); color: var(--pc-ink); }
  .tema-mapa a.no { border: 1.5px dashed var(--pc); color: var(--ink-2); }
  .tema-mapa b { font: 800 1rem/1.1 var(--font-sans); }
  .tema-mapa span { font-size: 0.78rem; }
</style>
