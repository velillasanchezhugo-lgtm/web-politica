---
/**
 * Bloque publicitario. Solo se pinta si AdSense está configurado y activado (ver config/site.ts).
 * Reserva altura fija para evitar saltos de contenido (CLS) y se identifica como publicidad.
 * No se coloca nunca dentro de herramientas, junto a controles ni entre una afirmación y su fuente.
 */
import { ADS } from '../config/site';
interface Props { slot?: 'inarticle' | 'footer' }
const { slot = 'inarticle' } = Astro.props;
const slotId = ADS.slots[slot];
const show = ADS.enabled && !!slotId;
---
{show && (
  <aside class="ad-slot wrap no-print" aria-label="Publicidad">
    <span class="ad-label">Publicidad</span>
    <ins class="adsbygoogle ad-box" style="display:block" data-ad-client={ADS.client} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
